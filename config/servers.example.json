{
  "autoApproveAtOrAbove": "trusted",
  "approvalTtlSeconds": 300,
  "servers": [
    {
      "id": "github",
      "displayName": "GitHub",
      "trust": "trusted",
      "transport": {
        "type": "http",
        "url": "https://api.githubcopilot.com/mcp/",
        "headers": {
          "Authorization": "Bearer ${GITHUB_TOKEN}"
        }
      }
    },
    {
      "id": "github-oauth",
      "displayName": "GitHub (OAuth)",
      "trust": "trusted",
      "enabled": false,
      "transport": {
        "type": "http",
        "url": "https://api.githubcopilot.com/mcp/",
        "auth": {
          "type": "oauth2",
          "authorizationUrl": "https://github.com/login/oauth/authorize",
          "tokenUrl": "https://github.com/login/oauth/access_token",
          "clientIdEnv": "GITHUB_OAUTH_CLIENT_ID",
          "clientSecretEnv": "GITHUB_OAUTH_CLIENT_SECRET",
          "scopes": ["repo", "read:org"],
          "redirectUri": "http://127.0.0.1:7788/callback"
        }
      }
    },
    {
      "id": "slack",
      "displayName": "Slack",
      "trust": "untrusted",
      "enabled": false,
      "transport": {
        "type": "http",
        "url": "https://slack.example.com/mcp",
        "auth": {
          "type": "oauth2",
          "authorizationUrl": "https://slack.com/oauth/v2/authorize",
          "tokenUrl": "https://slack.com/api/oauth.v2.access",
          "clientIdEnv": "SLACK_CLIENT_ID",
          "clientSecretEnv": "SLACK_CLIENT_SECRET",
          "clientAuthMethod": "client_secret_post",
          "scopes": ["channels:read", "chat:write"],
          "redirectUri": "http://127.0.0.1:7788/callback",
          "extraAuthorizationParams": {
            "user_scope": "search:read"
          }
        }
      }
    },
    {
      "id": "jira",
      "displayName": "Jira",
      "trust": "untrusted",
      "enabled": false,
      "transport": {
        "type": "http",
        "url": "https://jira.example.com/mcp",
        "auth": {
          "type": "oauth2",
          "authorizationUrl": "https://auth.atlassian.com/authorize",
          "tokenUrl": "https://auth.atlassian.com/oauth/token",
          "clientIdEnv": "JIRA_CLIENT_ID",
          "clientSecretEnv": "JIRA_CLIENT_SECRET",
          "clientAuthMethod": "client_secret_post",
          "scopes": ["read:jira-work", "write:jira-work", "offline_access"],
          "redirectUri": "http://127.0.0.1:7788/callback",
          "audience": "api.atlassian.com",
          "extraAuthorizationParams": {
            "prompt": "consent"
          }
        }
      }
    },
    {
      "id": "internal-service",
      "displayName": "Internal service (machine-to-machine)",
      "trust": "trusted",
      "enabled": false,
      "transport": {
        "type": "http",
        "url": "https://internal.example.com/mcp",
        "auth": {
          "type": "oauth2",
          "grantType": "client_credentials",
          "tokenUrl": "https://internal.example.com/oauth2/token",
          "clientId": "action-hub",
          "clientSecretEnv": "INTERNAL_CLIENT_SECRET",
          "scopes": ["mcp.invoke"]
        }
      }
    },
    {
      "id": "linear",
      "displayName": "Linear",
      "trust": "trusted",
      "maxOldSpaceSizeMb": 512,
      "heartbeat": {
        "intervalMs": 30000,
        "timeoutMs": 5000
      },
      "circuitBreaker": {
        "failureThreshold": 3,
        "cooldownMs": 10000
      },
      "restartBackoff": {
        "initialMs": 250,
        "maxMs": 30000,
        "jitter": 0.2
      },
      "transport": {
        "type": "stdio",
        "command": "npx",
        "args": ["-y", "mcp-remote", "https://mcp.linear.app/mcp"]
      }
    },
    {
      "id": "filesystem",
      "displayName": "Local filesystem",
      "trust": "untrusted",
      "denyTools": ["write_file", "move_file"],
      "maxOldSpaceSizeMb": 256,
      "transport": {
        "type": "stdio",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-filesystem", "~/Projects"]
      }
    },
    {
      "id": "chrome-devtools",
      "displayName": "Chrome DevTools",
      "trust": "untrusted",
      "enabled": false,
      "transport": {
        "type": "stdio",
        "command": "npx",
        "args": ["-y", "chrome-devtools-mcp@latest"]
      }
    }
  ]
}

{
  "autoApproveAtOrAbove": "trusted",
  "approvalTtlSeconds": 300,
  "servers": [
    {
      "id": "github",
      "displayName": "GitHub",
      "trust": "trusted",
      "transport": {
        "type": "http",
        "url": "https://api.githubcopilot.com/mcp/",
        "headers": {
          "Authorization": "Bearer ${GITHUB_TOKEN}"
        }
      }
    },
    {
      "id": "linear",
      "displayName": "Linear",
      "trust": "trusted",
      "maxOldSpaceSizeMb": 512,
      "heartbeat": {
        "intervalMs": 30000,
        "timeoutMs": 5000
      },
      "circuitBreaker": {
        "failureThreshold": 3,
        "cooldownMs": 10000
      },
      "restartBackoff": {
        "initialMs": 250,
        "maxMs": 30000,
        "jitter": 0.2
      },
      "transport": {
        "type": "stdio",
        "command": "npx",
        "args": ["-y", "mcp-remote", "https://mcp.linear.app/mcp"]
      }
    },
    {
      "id": "filesystem",
      "displayName": "Local filesystem",
      "trust": "untrusted",
      "denyTools": ["write_file", "move_file"],
      "maxOldSpaceSizeMb": 256,
      "transport": {
        "type": "stdio",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-filesystem", "~/Projects"]
      }
    },
    {
      "id": "chrome-devtools",
      "displayName": "Chrome DevTools",
      "trust": "untrusted",
      "enabled": false,
      "transport": {
        "type": "stdio",
        "command": "npx",
        "args": ["-y", "chrome-devtools-mcp@latest"]
      }
    }
  ]
}

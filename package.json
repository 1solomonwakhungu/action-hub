{
  "name": "action-hub-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Indexed, on-demand capability layer for MCP servers and skills",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/plugin/server",
    "packages/cli"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "eval": "npm run eval --workspace @action-hub/core",
    "build:bundle": "node scripts/bundle.mjs",
    "build:binary": "node scripts/build-binary.mjs",
    "dist": "npm run build && npm run build:bundle && npm run build:binary",
    "smoke:binary": "node scripts/smoke-test.mjs",
    "checksums": "node scripts/checksums.mjs",
    "gen:homebrew": "node scripts/gen-homebrew.mjs",
    "gen:winget": "node scripts/gen-winget.mjs",
    "clean": "rm -rf packages/*/dist packages/*/*/dist build dist-bin"
  },
  "devDependencies": {
    "esbuild": "0.24.2",
    "postject": "1.0.0-alpha.6",
    "typescript": "^5.6.3"
  }
}

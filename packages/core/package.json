{
  "name": "@action-hub/core",
  "version": "0.2.0",
  "description": "Runtime-agnostic capability catalog, search, and execution router for MCP servers and skills",
  "license": "MIT",
  "homepage": "https://1solomonwakhungu.github.io/action-hub/",
  "bugs": {
    "url": "https://github.com/1solomonwakhungu/action-hub/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1solomonwakhungu/action-hub.git",
    "directory": "packages/core"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "mcp-aggregator",
    "ai-agents",
    "claude-code",
    "cursor",
    "codex",
    "tool-search",
    "semantic-search",
    "context-engineering",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "vendor"
  ],
  "dependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.eval.json --noEmit",
    "test": "npm run build && node --import ../../test-isolation.mjs --test test/*.test.ts",
    "eval": "npm run build && node eval/run.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.6.3"
  }
}

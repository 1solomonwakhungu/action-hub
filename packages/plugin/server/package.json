{
  "name": "@action-hub/mcp-server",
  "version": "0.2.0",
  "description": "Meta-MCP server exposing the Action Hub catalog to any MCP host as a single tool",
  "license": "MIT",
  "homepage": "https://1solomonwakhungu.github.io/action-hub/",
  "bugs": {
    "url": "https://github.com/1solomonwakhungu/action-hub/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1solomonwakhungu/action-hub.git",
    "directory": "packages/plugin/server"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "mcp-aggregator",
    "ai-agents",
    "claude-code",
    "cursor",
    "codex",
    "tool-search",
    "semantic-search",
    "context-engineering",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "action-hub-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --import ../../../test-isolation.mjs --test test/*.test.ts"
  },
  "dependencies": {
    "@action-hub/core": "0.2.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@opentelemetry/api": "^1.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}

{
  "description": "Deterministic as-of revenue fixture for stress/eval-asof-execution.mjs. All dates are pinned to calendar year 2025 (plus 2024-12-31 for one pre-history cutoff); nothing reads the clock. The fixture server (stress/asof-fixture-server.mjs) owns the as-of logic; Action Hub is graded only on routing the request and carrying arguments and results intact.",
  "year": 2025,
  "serverId": "fixture-filings",
  "goldTool": "get_revenue_as_of",
  "asOfRule": "the filing with the latest acceptedDate on or before asOf wins (inclusive); no such filing means status no_data",
  "entities": {
    "ACME": {
      "filings": [
        { "id": "A-2025-01-10", "acceptedDate": "2025-01-10", "metric": "revenue", "value": 100, "unit": "USD", "kind": "original" },
        { "id": "B-2025-02-10", "acceptedDate": "2025-02-10", "metric": "revenue", "value": 110, "unit": "USD", "kind": "amendment", "amends": "A-2025-01-10" },
        { "id": "A-2025-01-10", "acceptedDate": "2025-01-10", "metric": "net_income", "value": 7, "unit": "USD", "kind": "original" },
        { "id": "B-2025-02-10", "acceptedDate": "2025-02-10", "metric": "net_income", "value": 9, "unit": "USD", "kind": "amendment", "amends": "A-2025-01-10" }
      ]
    },
    "ZEROCO": {
      "filings": [
        { "id": "Z-2025-01-05", "acceptedDate": "2025-01-05", "metric": "revenue", "value": 0, "unit": "USD", "kind": "original" },
        { "id": "Z-2025-01-05", "acceptedDate": "2025-01-05", "metric": "net_income", "value": -3, "unit": "USD", "kind": "original" }
      ]
    }
  },
  "tools": [
    {
      "name": "get_revenue_as_of",
      "description": "Point-in-time revenue for a company as of a cutoff date: returns the revenue value from the latest filing accepted on or before the asOf date, together with that filing's source ID. Later amendments are ignored. Returns status no_data when no filing had been accepted by the cutoff.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "entity": { "type": "string", "description": "Company identifier, e.g. ACME" },
          "asOf": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Cutoff date, YYYY-MM-DD (inclusive)" }
        },
        "required": ["entity", "asOf"],
        "additionalProperties": false
      },
      "annotations": { "readOnlyHint": true }
    },
    {
      "name": "get_latest_revenue",
      "description": "Latest revenue for a company, restated with every amendment filed to date. Returns the current value only; takes no cutoff date.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "entity": { "type": "string", "description": "Company identifier, e.g. ACME" },
          "fiscalPeriod": { "type": "string", "description": "Optional fiscal period label" }
        },
        "required": ["entity"],
        "additionalProperties": false
      },
      "annotations": { "readOnlyHint": true }
    },
    {
      "name": "get_net_income_as_of",
      "description": "Point-in-time net income for a company as of a cutoff date, from the latest filing accepted on or before the asOf date, with the source filing ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "entity": { "type": "string", "description": "Company identifier, e.g. ACME" },
          "asOf": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Cutoff date, YYYY-MM-DD (inclusive)" }
        },
        "required": ["entity", "asOf"],
        "additionalProperties": false
      },
      "annotations": { "readOnlyHint": true }
    },
    {
      "name": "list_filings",
      "description": "List the filing IDs and acceptance dates recorded for a company, optionally within a date window.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "entity": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" }
        },
        "required": ["entity"],
        "additionalProperties": false
      },
      "annotations": { "readOnlyHint": true }
    }
  ],
  "rows": [
    {
      "id": "jan31-original",
      "query": "What was ACME's revenue as of January 31, 2025?",
      "args": { "entity": "ACME", "asOf": "2025-01-31" },
      "expect": { "status": "ok", "value": 100, "sourceId": "A-2025-01-10" }
    },
    {
      "id": "jan31-paraphrase-sales",
      "query": "What did ACME's books show for sales back on Jan 31, 2025, before the restatement?",
      "args": { "entity": "ACME", "asOf": "2025-01-31" },
      "expect": { "status": "ok", "value": 100, "sourceId": "A-2025-01-10" }
    },
    {
      "id": "jan31-disclosed-by",
      "query": "How much revenue had ACME disclosed by 2025-01-31?",
      "args": { "entity": "ACME", "asOf": "2025-01-31" },
      "expect": { "status": "ok", "value": 100, "sourceId": "A-2025-01-10" }
    },
    {
      "id": "jan10-boundary",
      "query": "ACME revenue as of 2025-01-10, the day the original filing was accepted",
      "args": { "entity": "ACME", "asOf": "2025-01-10" },
      "expect": { "status": "ok", "value": 100, "sourceId": "A-2025-01-10" }
    },
    {
      "id": "feb10-amendment",
      "query": "ACME revenue as of February 10, 2025, point in time",
      "args": { "entity": "ACME", "asOf": "2025-02-10" },
      "expect": { "status": "ok", "value": 110, "sourceId": "B-2025-02-10" }
    },
    {
      "id": "mar01-after-amendment",
      "query": "What revenue had ACME reported as of March 1, 2025?",
      "args": { "entity": "ACME", "asOf": "2025-03-01" },
      "expect": { "status": "ok", "value": 110, "sourceId": "B-2025-02-10" }
    },
    {
      "id": "jan09-before-any-filing",
      "query": "ACME revenue as of January 9, 2025, before any filing",
      "args": { "entity": "ACME", "asOf": "2025-01-09" },
      "expect": { "status": "no_data" }
    },
    {
      "id": "dec31-prior-year",
      "query": "What was ACME's revenue as of December 31, 2024?",
      "args": { "entity": "ACME", "asOf": "2024-12-31" },
      "expect": { "status": "no_data" }
    },
    {
      "id": "zero-revenue-control",
      "query": "What was ZEROCO's revenue as of January 31, 2025?",
      "args": { "entity": "ZEROCO", "asOf": "2025-01-31" },
      "expect": { "status": "ok", "value": 0, "sourceId": "Z-2025-01-05" }
    },
    {
      "id": "unknown-entity-error-control",
      "query": "What was NOSUCHCO's revenue as of January 31, 2025?",
      "args": { "entity": "NOSUCHCO", "asOf": "2025-01-31" },
      "expect": { "status": "error" }
    }
  ]
}
